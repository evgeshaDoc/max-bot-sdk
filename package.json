{
  "name": "@tlman/max-bot-sdk",
  "version": "0.2.5-tlman.1",
  "description": "Lossless TypeScript SDK for the current MAX Bot API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evgeshaDoc/max-bot-sdk.git"
  },
  "homepage": "https://github.com/evgeshaDoc/max-bot-sdk#readme",
  "bugs": "https://github.com/evgeshaDoc/max-bot-sdk/issues",
  "author": "Tlman",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "UPSTREAM.md",
    "NOTICE",
    "LICENSE"
  ],
  "exports": {
    "./api": "./dist/api.js",
    "./bot": "./dist/bot.js",
    "./composer": "./dist/composer.js",
    "./context": "./dist/context.js",
    "./filter-query": "./dist/filter-query.js",
    "./filters": "./dist/filters.js",
    "./middleware": "./dist/middleware.js",
    "./session": "./dist/session.js",
    "./webhook": "./dist/webhook.js",
    "./webhook-adapters": "./dist/webhook-adapters.js",
    "./webhook-server": "./dist/webhook-server.js",
    "./attachments": "./dist/core/helpers/attachments.js",
    "./buttons": "./dist/core/helpers/buttons.js",
    "./keyboard": "./dist/core/helpers/keyboard.js",
    "./upload": "./dist/core/helpers/upload.js",
    "./client": "./dist/core/network/api/client.js",
    "./errors": "./dist/core/network/api/error.js",
    "./parse-update": "./dist/core/network/api/parse-update.js",
    "./raw-api": "./dist/core/network/api/raw-api.js",
    "./modules/subscriptions": "./dist/core/network/api/modules/subscriptions/types.js",
    "./api-methods": "./dist/core/network/api/modules/types.js",
    "./types/attachment": "./dist/core/network/api/types/attachment.js",
    "./types/attachment-request": "./dist/core/network/api/types/attachment-request.js",
    "./types/bot": "./dist/core/network/api/types/bot.js",
    "./types/chat": "./dist/core/network/api/types/chat.js",
    "./types/common": "./dist/core/network/api/types/common.js",
    "./types/int64": "./dist/core/network/api/types/int64.js",
    "./types/keyboard": "./dist/core/network/api/types/keyboard.js",
    "./types/markup": "./dist/core/network/api/types/markup.js",
    "./types/message": "./dist/core/network/api/types/message.js",
    "./types/update": "./dist/core/network/api/types/update.js",
    "./types/upload": "./dist/core/network/api/types/uploads.js",
    "./types/user": "./dist/core/network/api/types/user.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:examples": "npm run build --silent && tsc --noEmit --strict --skipLibCheck --module Node16 --moduleResolution Node16 --target ES2020 examples/*.ts",
    "lint": "eslint ./src ./test --ext ts --report-unused-disable-directives && node --check test/packed-consumer.mjs && node --check test/live-webhook-gate.mjs && node --check test/fastify-webhook-integration.mjs && node --check test/bun-webhook-smoke.mjs",
    "test:compile": "node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test .test-dist/test/*.test.js",
    "test:webhook:fastify": "npm run build --silent && node test/fastify-webhook-integration.mjs",
    "test:webhook:bun": "npm run build --silent && bun test/bun-webhook-smoke.mjs",
    "test:pack": "node test/packed-consumer.mjs",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/express": "5.0.6",
    "@types/node": "^22.5.5",
    "@types/vcf": "^2.0.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.2.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.25.2",
    "express": "5.2.1",
    "fastify": "5.11.3",
    "typescript": "^5.4.2"
  },
  "dependencies": {
    "@tsofist/stem": "8.2.1",
    "debug": "^4.3.7",
    "lossless-json": "4.3.1",
    "vcf": "^2.1.2"
  }
}
